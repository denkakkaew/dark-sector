; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dark Sector"
; The kiosk's attract screen — the game boots here and idles here between players.
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[autoload]

; Cross-scene state (score, energy, quiz tally, run timer). Autoloaded so it
; survives the screen changes between briefing, quiz and battle.
GameState="*res://autoload/GameState.gd"
; The ranked board, persisted in user://. After GameState because it reads a
; finished run straight off it.
Leaderboard="*res://autoload/Leaderboard.gd"
; Owns every screen transition. Loaded last because it drives both of the above.
SceneRouter="*res://autoload/SceneRouter.gd"
; Sound. After the router only because nothing above it makes noise; it reads no
; other autoload.
Audio="*res://autoload/Audio.gd"
; Takes an abandoned kiosk back to the attract screen. Last, because resetting
; means driving GameState and SceneRouter both.
IdleWatch="*res://autoload/IdleWatch.gd"

[display]

; The whole scene is composed for one fixed 16:9 landscape screen — the turret's
; framing, the station plate spanning the bottom corners and the reticle-to-aim
; mapping are all tuned against that shape. "keep" letterboxes/pillarboxes any
; other window shape with black bars rather than re-framing the 3D, so maximising
; or resizing scales the picture instead of changing it.
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

; The Thai build's font, applied to the default theme so every Label, Button and
; LineEdit picks it up without a per-node override. The engine default has no
; Thai glyphs — without this line every screen draws tofu. See the header of the
; resource itself for the weight and fallback choices.
theme/custom_font="res://assets/font/ui_font.tres"

[filesystem]

; Blender source files live under planning/ and are brought in as .glb by
; blender/export_turret.py, never imported directly. Without this, Godot tries
; to import planning/Turret.blend and fails asking for a Blender executable.
import/blender/enabled=false

[input]

fire={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
