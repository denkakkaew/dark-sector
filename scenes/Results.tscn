[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/Results.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/SpaceBackdrop.tscn" id="2"]

; The board sits on its own dark plate. It is the densest text in the game — six
; columns of small numbers — and it is the one screen that cannot afford Earth
; showing through behind it.
[sub_resource type="StyleBoxFlat" id="StyleBox_table"]
content_margin_left = 30.0
content_margin_top = 20.0
content_margin_right = 30.0
content_margin_bottom = 20.0
bg_color = Color(0.05, 0.06, 0.1, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.45, 0.62, 0.9)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="Results" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.035, 0.06, 1)

[node name="SpaceBackdrop" parent="." instance=ExtResource("2")]

[node name="Layout" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 70
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 70
theme_override_constants/margin_bottom = 18

[node name="Column" type="VBoxContainer" parent="Layout"]
alignment = 1
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(1, 0.87, 0.35, 1)
text = "🏆  ทำเนียบผู้พิทักษ์"
horizontal_alignment = 1

; How the run that just ended finished — recoloured and rewritten at runtime,
; and hidden entirely when the board was opened from the title.
[node name="Outcome" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.25, 0.92, 0.62, 1)
text = "ปกป้องโลกสำเร็จ"
horizontal_alignment = 1

[node name="TablePanel" type="PanelContainer" parent="Layout/Column"]
size_flags_horizontal = 4
theme_override_styles/panel = SubResource("StyleBox_table")

; Rows are added by Results.gd — the column set lives there, next to the code
; that formats each cell, so adding a column is one edit and not three.
[node name="Table" type="GridContainer" parent="Layout/Column/TablePanel"]
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
columns = 6

[node name="ResultLine" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.92, 0.95, 1, 1)
text = "คะแนนของคุณ: 0"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Layout/Column"]
alignment = 1
theme_override_constants/separation = 24

[node name="PlayAgainButton" type="Button" parent="Layout/Column/Buttons"]
custom_minimum_size = Vector2(260, 74)
theme_override_font_sizes/font_size = 26
text = "↻  เล่นอีกครั้ง"

[node name="SignOutButton" type="Button" parent="Layout/Column/Buttons"]
custom_minimum_size = Vector2(240, 74)
theme_override_font_sizes/font_size = 26
text = "⎋  ออกจากระบบ"

[node name="TitleButton" type="Button" parent="Layout/Column/Buttons"]
custom_minimum_size = Vector2(240, 74)
theme_override_font_sizes/font_size = 26
text = "⌂  หน้าแรก"
