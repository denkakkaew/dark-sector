[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/FactCard.gd" id="1"]
[ext_resource type="Script" path="res://scripts/DestinationBackdrop.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/SpaceBackdrop.tscn" id="3"]

; Same scrim as the briefing: the photograph is scenery, the card is the point.
[sub_resource type="Gradient" id="Gradient_scrim"]
offsets = PackedFloat32Array(0, 0.42, 1)
colors = PackedColorArray(0.02, 0.025, 0.05, 0, 0.02, 0.025, 0.05, 0.45, 0.02, 0.025, 0.05, 0.82)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_scrim"]
gradient = SubResource("Gradient_scrim")
width = 8
height = 128
fill_to = Vector2(0, 1)

; Border is recoloured to the scene's accent at runtime, so this is only the
; card's shape and its dark fill. Roomier margins than it had on the briefing —
; it is the whole screen now, not one block on a stack.
[sub_resource type="StyleBoxFlat" id="StyleBox_fact"]
content_margin_left = 44.0
content_margin_top = 34.0
content_margin_right = 44.0
content_margin_bottom = 34.0
bg_color = Color(0.07, 0.08, 0.12, 0.95)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.42, 0.56, 0.75, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="FactCard" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.035, 0.04, 0.07, 1)

; Held a little further back than on the briefing: this screen is one paragraph
; that has to be read, and it is the only thing on it.
[node name="Photo" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("2")
image_alpha = 0.34

[node name="Scrim" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = SubResource("GradientTexture2D_scrim")

; As on the briefing, and quieter still: this screen is one paragraph to read,
; and the default lane crosses both the mission line and the card's top corners.
[node name="SpaceBackdrop" parent="." instance=ExtResource("3")]
image_opacity = 0.0
ship_opacity = 0.22
ship_count = 2
ship_width_range = Vector2(70, 100)
lane_range = Vector2(0.02, 0.06)

[node name="AccentWash" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.24, 0.55, 0.9, 0.16)

[node name="Layout" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 90
theme_override_constants/margin_top = 50
theme_override_constants/margin_right = 90
theme_override_constants/margin_bottom = 50

[node name="Column" type="VBoxContainer" parent="Layout"]
alignment = 1
theme_override_constants/separation = 16

; Small and quiet — it only says which mission this fact belongs to, so the
; screen still knows where it is without competing with the card.
[node name="Mission" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.62, 0.72, 0.85, 1)
text = "MISSION 1 OF 4 · ISS"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Layout/Column"]
custom_minimum_size = Vector2(0, 10)

[node name="Card" type="PanelContainer" parent="Layout/Column"]
custom_minimum_size = Vector2(900, 0)
size_flags_horizontal = 4
theme_override_styles/panel = SubResource("StyleBox_fact")

[node name="CardBox" type="VBoxContainer" parent="Layout/Column/Card"]
