[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/AlienShip.gd" id="1"]

; One shape for every hull in AlienShip.HULLS, sized to the widest of them —
; the saucer, as measured and printed by blender/export_alien.py. The other two
; are exported inside it (1.86 x 0.68 x 1.86 and 1.86 x 1.00 x 1.86), so this
; box is a little generous on them, which only makes a near miss count as a
; hit; that is the friendly side to err on for this audience. Re-run the export
; scripts after editing a model and widen this if one grows past it.
[sub_resource type="BoxShape3D" id="BoxShape3D_1"]
size = Vector3(1.93, 1.15, 1.87)

[node name="AlienShip" type="Area3D"]
script = ExtResource("1")
speed = 8.0

; Deliberately empty: AlienShip._wear_a_hull() hangs a randomly drawn hull here
; as the ship spawns. Every hull is exported centred on its own bounds and
; facing +Z, so none of them needs a transform — they already look down the axis
; they fly along, at the player.
[node name="Model" type="Node3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_1")
