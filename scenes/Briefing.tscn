[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/Briefing.gd" id="1"]

; Border is recoloured to the scene's accent at runtime, so this is only the
; card's shape and its dark fill.
[sub_resource type="StyleBoxFlat" id="StyleBox_fact"]
content_margin_left = 36.0
content_margin_top = 26.0
content_margin_right = 36.0
content_margin_bottom = 26.0
bg_color = Color(0.07, 0.08, 0.12, 0.95)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.42, 0.56, 0.75, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="Briefing" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.035, 0.04, 0.07, 1)

; Tinted to the scene's accent at runtime — the cheapest way to make the four
; missions read as four different places before Phase 6's backdrops exist.
[node name="AccentWash" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.24, 0.55, 0.9, 0.1)

[node name="Layout" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 90
theme_override_constants/margin_top = 50
theme_override_constants/margin_right = 90
theme_override_constants/margin_bottom = 50

[node name="Column" type="VBoxContainer" parent="Layout"]
alignment = 1
theme_override_constants/separation = 16

[node name="Mission" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.7, 0.78, 0.9, 1)
text = "MISSION 1 OF 4"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 52
theme_override_colors/font_color = Color(1, 0.94, 0.78, 1)
text = "ISS — First Contact"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Rule" type="ColorRect" parent="Layout/Column"]
custom_minimum_size = Vector2(260, 4)
size_flags_horizontal = 4
color = Color(0.24, 0.55, 0.9, 1)

[node name="Callsign" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.62, 0.72, 0.85, 1)
text = "DEFENDER"
horizontal_alignment = 1

[node name="Story" type="Label" parent="Layout/Column"]
custom_minimum_size = Vector2(880, 0)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.92, 0.95, 1, 1)
text = "Alien scouts are attacking the International Space Station — man the turret!"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Gap" type="Control" parent="Layout/Column"]
custom_minimum_size = Vector2(0, 14)

[node name="FactCard" type="PanelContainer" parent="Layout/Column"]
custom_minimum_size = Vector2(860, 0)
size_flags_horizontal = 4
theme_override_styles/panel = SubResource("StyleBox_fact")

[node name="FactBox" type="VBoxContainer" parent="Layout/Column/FactCard"]
theme_override_constants/separation = 12

[node name="FactHeading" type="Label" parent="Layout/Column/FactCard/FactBox"]
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(1, 0.87, 0.35, 1)
text = "DID YOU KNOW?"
horizontal_alignment = 1

[node name="FactText" type="Label" parent="Layout/Column/FactCard/FactBox"]
theme_override_font_sizes/font_size = 25
theme_override_colors/font_color = Color(0.95, 0.97, 1, 1)
text = "The ISS orbits ~400 km above Earth."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Gap2" type="Control" parent="Layout/Column"]
custom_minimum_size = Vector2(0, 6)

; The only way out of this screen. Nothing here is on a timer — the fact card is
; the teaching moment, so the player decides when they have finished reading it.
[node name="ContinueButton" type="Button" parent="Layout/Column"]
custom_minimum_size = Vector2(460, 84)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "START THE QUIZ"

; Stripped before the kiosk build — see Briefing.gd.
[node name="DevHint" type="Label" parent="."]
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -320.0
offset_top = -38.0
offset_right = -20.0
offset_bottom = -14.0
grow_horizontal = 0
grow_vertical = 0
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.45, 0.5, 0.6, 1)
text = "DEV · press 1-4 to jump to a scene"
horizontal_alignment = 2
