[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/Briefing.gd" id="1"]
[ext_resource type="Script" path="res://scripts/DestinationBackdrop.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/SpaceBackdrop.tscn" id="3"]

; Darkens the lower two-thirds of the destination photograph, where the story
; line and the button sit. Earth's night-side city lights and Mars' bright
; orange are the two images this exists for.
[sub_resource type="Gradient" id="Gradient_scrim"]
offsets = PackedFloat32Array(0, 0.42, 1)
colors = PackedColorArray(0.02, 0.025, 0.05, 0, 0.02, 0.025, 0.05, 0.45, 0.02, 0.025, 0.05, 0.82)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_scrim"]
gradient = SubResource("Gradient_scrim")
width = 8
height = 128
fill_to = Vector2(0, 1)

[node name="Briefing" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.035, 0.04, 0.07, 1)

; The destination itself — a photograph of the battle this briefing is sending
; the player into. Faded in by its own script.
[node name="Photo" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("2")
image_alpha = 0.4

[node name="Scrim" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = SubResource("GradientTexture2D_scrim")

; Alien traffic drifting over the photograph. Its own Earth is switched off —
; there is a real destination behind it now, and two stacked worlds read as fog.
;
; Flown higher, fainter and two at a time than its defaults: over a photograph
; the saucers read much harder than they do over flat dark, and the default lane
; puts one straight through the "MISSION n OF 4" line.
[node name="SpaceBackdrop" parent="." instance=ExtResource("3")]
image_opacity = 0.0
ship_opacity = 0.26
ship_count = 2
ship_width_range = Vector2(70, 100)
lane_range = Vector2(0.02, 0.06)

; Tinted to the scene's accent at runtime. With a photograph underneath, this is
; what makes Mars read as Mars at a glance from across the room.
[node name="AccentWash" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.24, 0.55, 0.9, 0.16)

[node name="Layout" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 90
theme_override_constants/margin_top = 50
theme_override_constants/margin_right = 90
theme_override_constants/margin_bottom = 50

[node name="Column" type="VBoxContainer" parent="Layout"]
alignment = 1
theme_override_constants/separation = 20

[node name="Mission" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.7, 0.78, 0.9, 1)
text = "ภารกิจที่ 1 จาก 4"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 52
theme_override_colors/font_color = Color(1, 0.94, 0.78, 1)
text = "สถานีอวกาศ ISS — เผชิญหน้าครั้งแรก"
horizontal_alignment = 1
autowrap_mode = 3

; Drawn open from nothing during the reveal, so its width is animated through
; `custom_minimum_size` — a VBoxContainer re-sorts its children every frame and
; would silently overwrite a tween on `position` or `size`.
[node name="Rule" type="ColorRect" parent="Layout/Column"]
custom_minimum_size = Vector2(260, 4)
size_flags_horizontal = 4
color = Color(0.24, 0.55, 0.9, 1)

[node name="Callsign" type="Label" parent="Layout/Column"]
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.62, 0.72, 0.85, 1)
text = "ผู้พิทักษ์"
horizontal_alignment = 1

[node name="Story" type="Label" parent="Layout/Column"]
custom_minimum_size = Vector2(880, 0)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.92, 0.95, 1, 1)
text = "ยานสอดแนมต่างดาวกำลังบุกสถานีอวกาศนานาชาติ — ประจำป้อมปืนเดี๋ยวนี้!"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Gap" type="Control" parent="Layout/Column"]
custom_minimum_size = Vector2(0, 18)

; The only way out of this screen, and it leads to the fact card rather than
; straight to the quiz. Nothing here is on a timer.
[node name="ContinueButton" type="Button" parent="Layout/Column"]
custom_minimum_size = Vector2(460, 84)
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "ต่อไป  ▶"

; Stripped before the kiosk build — see Briefing.gd.
[node name="DevHint" type="Label" parent="."]
anchor_left = 1.0
