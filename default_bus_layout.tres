[gd_resource type="AudioBusLayout" format=3]

; Three buses so the kiosk's two problems can be solved separately: music that
; is too loud against the shooting, and a machine in a room that needs turning
; down as a whole. Master is the room; Music and SFX are the mix.
[resource]
bus/0/volume_db = 0.0
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -9.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = -3.0
bus/2/send = &"Master"
