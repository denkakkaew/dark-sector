# Godot 4+ specific ignores
.godot/
/android/

# gdUnit4 generated test reports
/reports/

# Windows export output. A ~140 MB self-contained .exe (the engine template is
# 105 MB of that) — built on demand, never committed. The web build under docs/
# is the exception: GitHub Pages serves it straight out of the repository.
/build/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Bytecode from the Blender export scripts — export_alien_variants.py imports
# export_alien.py as a module, and Python caches it next to the source.
__pycache__/

# Local dev helpers / logs (machine-specific)
run.log
run-game.bat
export-web.bat

# Design sources, storyboards and raw model downloads (local only, ~1 GB).
# Godot also skips this dir via planning/.gdignore, and the Web export
# preset excludes it, so it never reaches docs/index.pck.
planning/
